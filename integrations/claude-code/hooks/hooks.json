{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/start.js" }] }],
    "PreToolUse": [{ "matcher": "Write|Edit|Bash|Read|Grep", "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/enforce.js" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/verdict.js" }] }]
  }
}
